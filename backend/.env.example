# Copy this file to .env and adjust as needed. Never commit .env.

# General
APP_ENV=development
DEBUG=true

# Database
# Either set DATABASE_URL directly, or leave it unset and let it be
# assembled from the POSTGRES_* values below (this is what docker-compose
# does, pointing POSTGRES_HOST at the `db` service).
# DATABASE_URL=postgresql+psycopg://sie:sie@localhost:5432/sie

POSTGRES_USER=sie
POSTGRES_PASSWORD=sie
POSTGRES_DB=sie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Identity & access — see README's "Identity architecture" section.
# DEV_MODE gates the one development-only identity mechanism this
# codebase has (a request header naming an existing user id, with no real
# credential or cryptographic verification behind it — see
# app/api/deps_auth.py). Leave this false everywhere except local
# development; it must never be true in a production environment.
DEV_MODE=false

# Ingestion — see README's "Universal ingestion architecture" section.
# Local-filesystem StorageProvider root (development only — a production
# deployment swaps in an object-storage-backed StorageProvider instead of
# repointing this at a "real" path; see app/ingestion/storage.py).
INGESTION_STORAGE_DIR=var/ingested_files
# Hard cap, in bytes, on one uploaded file's size.
MAX_UPLOAD_SIZE_BYTES=26214400

# LLM / RAG — see README's "Evidence-Grounded RAG" section.
# LLM_PROVIDER defaults to "fake" (a deterministic, offline test/dev
# provider — see app/llm/provider.py). This MUST stay "fake" for
# development/test/CI. Setting APP_ENV=production with LLM_PROVIDER still
# "fake" is a hard startup error by design (FakeLLMProviderInProductionError).
# LLM_PROVIDER=openai_compatible
# LLM_MODEL_NAME=gpt-4o-mini
# LLM_API_BASE_URL=https://api.openai.com/v1
# Never commit a real key here — set it as a real environment variable
# instead, e.g. via your deployment platform's secret manager.
# LLM_API_KEY=
# External-LLM privacy boundary — see README. Default false is the safe
# default; only enable this once you've confirmed your configured
# provider's data-handling terms for organization-private content.
# ALLOW_EXTERNAL_LLM_FOR_PRIVATE_DATA=false

# Semantic embeddings — see docs/SEMANTIC_EMBEDDING.md.
# EMBEDDING_PROVIDER defaults to "hashing" (a deterministic, offline
# test/dev provider — see app/embeddings/provider.py). This MUST stay
# "hashing" for development/test/CI. Setting APP_ENV=production with
# EMBEDDING_PROVIDER still "hashing" is a hard startup error by design
# (HashingProviderInProductionError) — the same "fail closed" shape
# LLM_PROVIDER=fake uses above.
# EMBEDDING_PROVIDER=sentence_transformers
# A real sentence-transformers model id (downloaded once, then cached —
# see EMBEDDING_MODEL_CACHE_DIR) or a local filesystem path to an
# already-saved model. Must match EMBEDDING_DIMENSIONS below exactly.
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL_VERSION=1
# EMBEDDING_DIMENSIONS=384
# "cpu" / "cuda" / "cuda:0" / "mps" — unset lets torch auto-detect.
# EMBEDDING_DEVICE=cpu
# Where downloaded model weights are cached on disk between process
# starts — unset uses sentence-transformers' own default cache directory.
# EMBEDDING_MODEL_CACHE_DIR=/var/cache/sie/models
# Passed to SentenceTransformer.encode(batch_size=...).
# EMBEDDING_BATCH_SIZE=32
