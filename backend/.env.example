# Copy this file to .env and adjust as needed. Never commit .env.

# General
APP_ENV=development
DEBUG=true

# Database
# Either set DATABASE_URL directly, or leave it unset and let it be
# assembled from the POSTGRES_* values below (this is what docker-compose
# does, pointing POSTGRES_HOST at the `db` service).
# DATABASE_URL=postgresql+psycopg://sie:sie@localhost:5432/sie

POSTGRES_USER=sie
POSTGRES_PASSWORD=sie
POSTGRES_DB=sie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Identity & access — see README's "Identity architecture" section.
# DEV_MODE gates the one development-only identity mechanism this
# codebase has (a request header naming an existing user id, with no real
# credential or cryptographic verification behind it — see
# app/api/deps_auth.py). Leave this false everywhere except local
# development; it must never be true in a production environment.
DEV_MODE=false
