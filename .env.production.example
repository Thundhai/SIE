# SIE frontend production OIDC configuration — SIE Milestone G3-1: Login
# & Production Session.
#
# Copy to .env.production.local (gitignored) for a real deployment, or
# set these as build-time environment variables in whatever CI/deploy
# pipeline runs `vite build`. Vite inlines every `VITE_`-prefixed value
# into the built bundle at build time — there is no runtime config
# reload, so these must be set *before* `vite build` runs, not after.
#
# These configure src/auth/oidcConfig.ts, consumed by
# src/auth/oidcSession.ts (built on oidc-client-ts, Authorization Code +
# PKCE — see that module's own docstring). Provider-neutral, mirroring
# the backend's own OIDC_* settings (backend/app/core/config.py): any
# standards-compliant OIDC provider works by setting these to that
# provider's own values — nothing provider-specific lives in this
# codebase.
#
# IMPORTANT — these are a DIFFERENT, separate decision from the
# backend's own OIDC_ISSUER/OIDC_AUDIENCE/OIDC_JWKS_URL settings (which
# configure token *verification*, not this browser client's own
# authorization-code flow). Both must point at the same provider/tenant
# to work together, but they are not interchangeable values.

VITE_API_BASE_URL=https://your-sie-backend.example.com/api/v1

# The provider's issuer URL, e.g.
# "https://login.microsoftonline.com/<tenant-id>/v2.0" (Azure AD),
# "https://<domain>.okta.com/oauth2/default" (Okta), or your own
# self-hosted Keycloak/other OIDC provider's issuer. Used purely for
# OIDC discovery (<authority>/.well-known/openid-configuration) -- SIE
# never hardcodes a specific provider's endpoint shape.
VITE_OIDC_AUTHORITY=

# This SPA's public client id, as registered with the provider above.
# No client secret is configured here, deliberately: a browser-based
# app is a public OAuth2 client, and Authorization Code + PKCE (which
# oidc-client-ts uses) needs none.
VITE_OIDC_CLIENT_ID=

# Optional -- defaults to "<this app's own origin>/callback" at runtime
# if unset. Set explicitly only if the registered redirect URI with your
# provider must differ from that default.
# VITE_OIDC_REDIRECT_URI=https://your-sie-frontend.example.com/callback

# Optional -- defaults to "openid profile email", which is sufficient
# for every identity claim SIE itself reads. SIE's own authorization
# (role/permission) is entirely separate from this token's scopes (see
# backend/app/services/authorization_service.py) -- widen this only if
# your specific provider requires an additional scope to even issue a
# token at all.
# VITE_OIDC_SCOPE=openid profile email

# Development-only identity (src/auth/devIdentity.ts) must NOT be set in
# a production deployment's environment. As of SIE Milestone G3-1 this
# is enforced in code regardless (getDevIdentityConfig() returns null
# whenever the build's own MODE is "production" -- see src/auth/
# authMode.ts), but the operational rule remains: never configure these
# here.
#   VITE_DEV_USER_ID
#   VITE_DEV_ORGANIZATION_ID
