# SIE frontend local-development identity — SIE Milestone UI-DEV-01.
#
# Copy this file to .env.local (gitignored) to resolve a real
# development organization/user through DevAuthProvider
# (src/auth/DevAuthProvider.tsx / src/auth/devIdentity.ts). Vite reads
# .env.local automatically; nothing else needs to change.
#
#   cp .env.development.example .env.local
#
# These are NOT secrets and NOT random — they are fixed, well-known
# constants that backend/scripts/seed_dev_environment.py creates with
# these exact same ids every time it seeds a fresh local database, so
# no UUID ever needs to be copied by hand between the backend and the
# frontend. See docs/DEVELOPMENT_SETUP.md for the full setup sequence
# (start Postgres, run migrations, run the seed script, start the
# backend with DEV_MODE=true, start this frontend).
#
# DevAuthProvider resolves these against the REAL backend
# (GET /organizations/{id}, GET /organizations/{id}/members/{user_id},
# GET /auth/me) — it is never a fabricated identity, and it never
# activates in production: ProdAuthProvider (a real OIDC/OAuth2 seam)
# is what a production build actually uses; nothing here can enable
# DEV_MODE on the backend, which is the backend's own, entirely
# separate, fail-closed environment variable.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Fixed development identifiers — must match
# backend/scripts/seed_dev_environment.py's DEV_ORGANIZATION_ID/DEV_USER_ID.
VITE_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000d01
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000d02

# Optional display-only overrides (DevAuthProvider falls back to the
# real backend-returned organization name regardless — these only seed
# the very first render before that request resolves). Left at their
# defaults here since the seed script creates the organization with
# exactly this name.
VITE_DEV_ORGANIZATION_NAME=SIE Local Development Organization
